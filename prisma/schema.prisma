generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  name      String
  role      Role       @default(CLIENT)
  status    UserStatus @default(PENDING)
  company   String?
  phone     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  client    Client?

  @@map("users")
}

model Client {
  id         String      @id @default(cuid())
  name       String
  company    String
  userId     String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  adAccounts AdAccount[]
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments   Comment[]
  goals      Goal[]

  @@map("clients")
}

model AdAccount {
  id           String           @id @default(cuid())
  name         String
  accountId    String
  platform     Platform
  clientId     String
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  accessToken  String?
  tokenStatus  String?
  refreshToken String?
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metrics      CampaignMetric[]

  @@unique([accountId, platform])
  @@map("ad_accounts")
}

model Comment {
  id        String   @id @default(cuid())
  clientId  String
  authorId  String
  text      String
  period    String?
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Goal {
  id        String   @id @default(cuid())
  clientId  String
  metric    String
  target    Float
  period    String
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("goals")
}

model CampaignMetric {
  id           String    @id @default(cuid())
  adAccountId  String
  date         DateTime
  spend        Float     @default(0)
  impressions  Int       @default(0)
  clicks       Int       @default(0)
  conversions  Int       @default(0)
  revenue      Float     @default(0)
  campaignName String?
  createdAt    DateTime  @default(now())
  platformData Json?
  adAccount    AdAccount @relation(fields: [adAccountId], references: [id], onDelete: Cascade)

  @@index([adAccountId])
  @@index([date])
  @@unique([adAccountId, date])
  @@map("campaign_metrics")
}

enum Role {
  ADMIN
  CLIENT
}

enum UserStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum Platform {
  FACEBOOK
  GOOGLE
  TIKTOK
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  createdAt DateTime @default(now())
  @@map("rate_limits")
}

model LoginAttempt {
  id           String    @id @default(cuid())
  email        String    @unique
  count        Int       @default(0)
  lastAt       DateTime  @default(now())
  blockedUntil DateTime?
  @@map("login_attempts")
}
